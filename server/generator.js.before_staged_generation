\`\`\`
`;
}

function createBuildWorkflow(projectName) {
  const name = safeName(projectName);

  return `name: Build Android APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.35.7'
          channel: stable
          cache: true

      - name: Create Android platform
        run: |
          rm -rf /tmp/flutter_template
          flutter create --platforms=android --project-name ${name} /tmp/flutter_template
          rm -rf android
          cp -r /tmp/flutter_template/android android

      - name: Get dependencies
        run: flutter pub get

      - name: Analyze project
        run: flutter analyze

      - name: Build release APK
        run: flutter build apk --release

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: ${name}-apk
          path: build/app/outputs/flutter-apk/app-release.apk
`;
}

function createDirectories(root) {
  const directories = [
    'lib',
    'lib/core',
    'lib/core/constants',
    'lib/core/database',
    'lib/core/errors',
    'lib/core/theme',
    'lib/core/utils',
    'lib/domain',
    'lib/domain/entities',
    'lib/domain/repositories',
    'lib/application',
    'lib/application/services',
    'lib/infrastructure',
    'lib/infrastructure/database',
    'lib/infrastructure/repositories',
    'lib/presentation',
    'lib/presentation/screens',
    'lib/presentation/widgets',
    'lib/presentation/providers',
    'test',
    '.github',
    '.github/workflows'
  ];

  for (const dir of directories) {
    fs.mkdirSync(path.join(root, dir), {
      recursive: true
    });
  }
}

function createBaseMain(plan) {
  const color = String(plan.design?.primaryColor || '#1565C0')
    .replace(/[^#a-fA-F0-9]/g, '')
    .slice(0, 7);

  const safeColor = /^#[0-9a-fA-F]{6}$/.test(color)
    ? color
    : '#1565C0';

  return `import 'package:flutter/material.dart';

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const MahaniApp());
}

class MahaniApp extends StatelessWidget {
  const MahaniApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: ${JSON.stringify(plan.appName)},
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: Color(0xFF${safeColor.substring(1)}),
        fontFamily: 'sans',
      ),
      builder: (context, child) {
        return Directionality(
          textDirection: TextDirection.rtl,
          child: child ?? const SizedBox.shrink(),
        );
      },
      home: const Scaffold(
        body: Center(
          child: Text(
            'تم إنشاء المشروع بنجاح',
            textAlign: TextAlign.center,
          ),
        ),
      ),
    );
  }
}
`;
}

function createGitignore() {
  return `# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
build/

# Android
.gradle/
.idea/

# Generated
*.iml

# Local
.env
`;
}

function generateDynamicFiles(root, plan) {
  const files = Array.isArray(plan.files) ? plan.files : [];

  let written = 0;

  for (const file of files) {
    if (!file || typeof file !== 'object') continue;

    const filePath = safeDartFileName(file.path);
    if (!filePath) continue;

    const content = String(file.content || '').trim();

    if (!content) continue;

    const fullPath = path.resolve(root, filePath);
    const libRoot = path.resolve(root, 'lib');

    if (!fullPath.startsWith(libRoot + path.sep)) {
      continue;
    }

    fs.mkdirSync(path.dirname(fullPath), {
      recursive: true
    });

    fs.writeFileSync(
      fullPath,
      content + '\n',
      'utf8'
    );

    written++;
  }

  return written;
}

function createFlutterBase(projectName, plan) {
  plan = normalizePlan(plan);

  const root = path.join(
    __dirname,
    'projects',
    safeName(projectName)
  );

  console.log('[GENERATOR] إنشاء مشروع Enterprise');
  console.log('[GENERATOR] Project:', plan.appName);
  console.log('[GENERATOR] Root:', root);

  fs.rmSync(root, {
    recursive: true,
    force: true
  });

  createDirectories(root);

  fs.writeFileSync(
    path.join(root, 'pubspec.yaml'),
    createPubspec(projectName, plan),
    'utf8'
  );

  fs.writeFileSync(
    path.join(root, 'README.md'),
    createReadme(projectName, plan),
    'utf8'
  );

  fs.writeFileSync(
    path.join(root, '.gitignore'),
    createGitignore(),
    'utf8'
  );

  fs.writeFileSync(
    path.join(root, 'lib', 'main.dart'),
    createBaseMain(plan),
    'utf8'
  );

  fs.writeFileSync(
    path.join(
      root,
      '.github',
      'workflows',
      'build-apk.yml'
    ),
    createBuildWorkflow(projectName),
    'utf8'
  );

  const writtenFiles = generateDynamicFiles(
    root,
    plan
  );

  console.log(
    '[GENERATOR] ملفات AI:',
    plan.files.length
  );

  console.log(
    '[GENERATOR] ملفات مكتوبة:',
    writtenFiles
  );

  return root;
}

module.exports = {
  createFlutterBase,
  safeName,
  normalizePlan
};
