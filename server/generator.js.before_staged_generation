const fs = require('fs');
const path = require('path');

function safeName(name) {
  return String(name || 'mahani_app')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_]+/g, '_')
    .replace(/^_+|_+$/g, '')
    .replace(/_+/g, '_') || 'mahani_app';
}

function normalizePlan(plan) {
  const p = plan || {};

  return {
    appName: p.appName || 'Mahani App',
    description: p.description || 'Generated by Mahani Builder AI',
    platform: p.platform || 'android',
    features: Array.isArray(p.features) ? p.features : [],
    screens: Array.isArray(p.screens) ? p.screens : [],
    data: p.data && typeof p.data === 'object' ? p.data : {},
    design: {
      style: p.design?.style || 'modern',
      direction: p.design?.direction || 'rtl',
      primaryColor: p.design?.primaryColor || '#1565C0'
    },
    files: Array.isArray(p.files) ? p.files : [],
    dependencies:
      p.dependencies && typeof p.dependencies === 'object'
        ? p.dependencies
        : {}
  };
}

function safeDartFileName(filePath) {
  const value = String(filePath || '').trim();

  if (!value.startsWith('lib/')) return null;
  if (!value.endsWith('.dart')) return null;
  if (value.includes('..')) return null;
  if (value.includes('\\')) return null;

  return value;
}

function createPubspec(projectName, plan) {
  const name = safeName(projectName);

  const description = String(plan.description || '')
    .replace(/\r?\n/g, ' ')
    .replace(/:/g, '-')
    .trim();

  const dependencies = {
    'cupertino_icons': '^1.0.8',
    'provider': '^6.1.2',
    'sqflite': '^2.4.2',
    'path': '^1.9.1',
    'shared_preferences': '^2.5.3',
    'intl': '^0.20.2',
    'flutter_local_notifications': '^19.4.0',
    'pdf': '^3.11.3',
    'printing': '^5.14.2',
    'excel': '^4.0.6',
    'file_picker': '^10.3.3',
    'permission_handler': '^12.0.1',
    'path_provider': '^2.1.5',
    'http': '^1.5.0',
    'uuid': '^4.5.1',
    'crypto': '^3.0.6'
  };

  for (const [key, value] of Object.entries(plan.dependencies)) {
    if (
      typeof key === 'string' &&
      typeof value === 'string' &&
      /^[a-zA-Z0-9_]+$/.test(key)
    ) {
      dependencies[key] = value;
    }
  }

  const dependencyText = Object.entries(dependencies)
    .map(([key, value]) => `  ${key}: ${value}`)
    .join('\n');

  return `name: ${name}
description: ${description || 'Generated by Mahani Builder AI'}
publish_to: "none"

version: 1.0.0+1

environment:
  sdk: ">=3.0.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter

${dependencyText}

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true
`;
}

