const fs = require('fs');
const path = require('path');

const MODEL =
  process.env.OPENROUTER_MODEL || 'cohere/north-mini-code:free';

function safeProjectName(name) {
  return String(name || 'mahani_app')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_]+/g, '_')
    .replace(/^_+|_+$/g, '')
    .replace(/_+/g, '_')
    .slice(0, 50) || `mahani_app_${Date.now()}`;
}

function root(projectName) {
  return path.join(
    __dirname,
    'projects',
    safeProjectName(projectName)
  );
}

async function askAI(apiKey, messages, maxTokens = 14000) {
  const controller = new AbortController();

  const timer = setTimeout(() => {
    controller.abort();
  }, 120000);

  try {
    const response = await fetch(
      'https://openrouter.ai/api/v1/chat/completions',
      {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
          'HTTP-Referer': 'http://127.0.0.1:3000',
          'X-Title': 'Mahani Builder AI'
        },
        body: JSON.stringify({
          model: MODEL,
          messages,
          temperature: 0,
          max_tokens: maxTokens,
          reasoning: {
            effort: 'minimal',
            exclude: true
          },
          response_format: {
            type: 'json_object'
          }
        }),
        signal: controller.signal
      }
    );

    const text = await response.text();

    let data;

    try {
      data = JSON.parse(text);
    } catch {
      throw new Error(
        'OpenRouter returned invalid JSON'
      );
    }

    if (!response.ok) {
      throw new Error(
        `OpenRouter HTTP ${response.status}: ${JSON.stringify(data).slice(0, 2000)}`
      );
    }

    const choice = data?.choices?.[0];

    if (!choice?.message?.content) {
      throw new Error(
        `AI generation failed: finish_reason=${choice?.finish_reason || "unknown"}; provider=${JSON.stringify(data?.error || null)}; choice=${JSON.stringify(choice || null).slice(0,6000)}`
      );
    }

    let content = choice.message.content;

    if (typeof content !== 'string') {
      content = JSON.stringify(content);
    }

    content = content
      .replace(/^```json\s*/i, '')
      .replace(/^```\s*/i, '')
      .replace(/\s*```$/i, '')
      .trim();

    try {
      return JSON.parse(content);
    } catch {
      throw new Error(
        'AI returned invalid JSON content'
      );
    }
  } finally {
    clearTimeout(timer);
  }
}

const PACKAGE_VERSIONS = {
  cupertino_icons: '^1.0.8',
  provider: '^6.1.5+1',
  sqflite: '^2.4.2',
  path: '^1.9.1',
  shared_preferences: '^2.5.3',
  intl: '^0.20.2',
  flutter_local_notifications: '^19.4.0',
  pdf: '^3.11.3',
  printing: '^5.14.2',
  excel: '^4.0.6',
  file_picker: '^10.2.0',
  permission_handler: '^12.0.1',
  path_provider: '^2.1.5',
  http: '^1.4.0',
  uuid: '^4.5.1',
  crypto: '^3.0.6'
};

function createPubspec(projectName, plan) {
  const packageName = safeProjectName(projectName);

  return `name: ${packageName}
description: ${String(
    plan?.description ||
    plan?.appName ||
    'Application generated by Mahani Builder AI'
  )
    .replace(/\n/g, ' ')
    .replace(/:/g, '-')
    .slice(0, 180)}

publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ">=3.9.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter

  cupertino_icons: ${PACKAGE_VERSIONS.cupertino_icons}
  provider: ${PACKAGE_VERSIONS.provider}
  sqflite: ${PACKAGE_VERSIONS.sqflite}
  path: ${PACKAGE_VERSIONS.path}
  shared_preferences: ${PACKAGE_VERSIONS.shared_preferences}
  intl: ${PACKAGE_VERSIONS.intl}
  flutter_local_notifications: ${PACKAGE_VERSIONS.flutter_local_notifications}
  pdf: ${PACKAGE_VERSIONS.pdf}
  printing: ${PACKAGE_VERSIONS.printing}
  excel: ${PACKAGE_VERSIONS.excel}
  file_picker: ${PACKAGE_VERSIONS.file_picker}
  permission_handler: ${PACKAGE_VERSIONS.permission_handler}
  path_provider: ${PACKAGE_VERSIONS.path_provider}
  http: ${PACKAGE_VERSIONS.http}
  uuid: ${PACKAGE_VERSIONS.uuid}
  crypto: ${PACKAGE_VERSIONS.crypto}

dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true
`;
}

function ensureProject(projectName, plan) {
  const projectRoot = root(projectName);

  fs.mkdirSync(
    path.join(projectRoot, 'lib'),
    { recursive: true }
  );

  const pubspecPath = path.join(
    projectRoot,
    'pubspec.yaml'
  );

  fs.writeFileSync(
    pubspecPath,
    createPubspec(projectName, plan),
    'utf8'
  );

  return projectRoot;
}

function buildGenerationPrompt(
  plan,
  stage,
  existingFiles
) {
  const stageRules = {
    core: `
أنشئ البنية الأساسية الحقيقية للتطبيق:
- lib/main.dart
- theme
- routes عند الحاجة
- core utilities
- application foundation

يجب أن يكون main.dart قابلاً للتشغيل.
لا تنشئ UI ضخمًا في هذه المرحلة.
`,

    data: `
أنشئ طبقة البيانات الحقيقية:
- models/entities
- SQLite عند الحاجة
- database
- repositories
- CRUD
- validation

لا تستخدم بيانات وهمية.
لا تستخدم fake data.
`,

    services: `
أنشئ الخدمات الحقيقية المطلوبة:
- services
- notifications
- backup
- import/export
- reports
- API/AI services عند الحاجة
- أي خدمة يحتاجها التطبيق فعليًا

لا تنشئ خدمات وهمية.
`,

    ui: `
أنشئ واجهات التطبيق الحقيقية.

كل شاشة يجب أن:
- تكون قابلة للاستخدام
- مرتبطة بالبيانات
- مرتبطة بالخدمات
- تدعم RTL
- تستخدم Material 3
- تحتوي حالات loading/error/empty عند الحاجة
- لا تكون مجرد تصميم شكلي

لا تستخدم fake data.
`
  };

  return `
أنت مهندس Flutter Production Senior داخل Mahani Builder AI.

مهمتك إنشاء تطبيق Flutter حقيقي قابل للبناء على GitHub Actions.

المشروع:
${JSON.stringify(plan)}

المرحلة:
${stage}

قواعد المرحلة:
${stageRules[stage] || ''}

الملفات الموجودة من المراحل السابقة:
${JSON.stringify(existingFiles)}

ممنوع منعًا باتًا:
- TODO
- placeholder
- fake data
- mock data
- Future.delayed
- بيانات وهمية
- كود تجريبي
- شرح بدل الكود
- Markdown داخل content
- imports لملفات غير موجودة
- package غير موجودة
- أخطاء Dart واضحة

المشروع يستخدم pubspec.yaml يتم إنشاؤه تلقائيًا.

الحزم المتاحة:
${JSON.stringify(Object.keys(PACKAGE_VERSIONS))}

قواعد imports:
- استخدم package imports عندما تكون مناسبة.
- استخدم imports صحيحة.
- لا تستورد ملفًا لم يتم إنشاؤه.
- لا تعيد إنشاء ملف موجود إلا إذا كان ضروريًا.
- جميع الملفات تحت lib/.
- كل content يجب أن يكون كود Dart كامل.
- يجب أن يكون الكود متوافقًا مع Dart 3.9+ وFlutter stable.
- التطبيق عربي RTL عندما تكون واجهته عربية.
- اجعل المرحلة قابلة للدمج مع المراحل السابقة.

أعد JSON فقط بهذا الشكل:

{
  "files": [
    {
      "path": "lib/main.dart",
      "purpose": "purpose",
      "content": "FULL DART CODE"
    }
  ]
}
`;
}

async function generateStage(
  apiKey,
  plan,
  stage,
  existingFiles
) {
  return askAI(
    apiKey,
    [
      {
        role: 'system',
        content:
          'You are a senior Flutter production engineer. Return valid JSON only.'
      },
      {
        role: 'user',
        content: buildGenerationPrompt(
          plan,
          stage,
          existingFiles
        )
      }
    ],
    14000
  );
}

function writeFiles(projectName, files) {
  const projectRoot = root(projectName);
  const libRoot = path.join(
    projectRoot,
    'lib'
  );

  fs.mkdirSync(
    libRoot,
    { recursive: true }
  );

  let written = 0;

  for (
    const file of Array.isArray(files)
      ? files
      : []
  ) {
    if (
      !file ||
      typeof file !== 'object'
    ) {
      continue;
    }

    const relative = String(
      file.path || ''
    ).trim();

    if (
      !relative.startsWith('lib/') ||
      relative.includes('..') ||
      relative.includes('\\') ||
      !relative.endsWith('.dart')
    ) {
      continue;
    }

    const full = path.resolve(
      projectRoot,
      relative
    );

    if (
      !full.startsWith(
        path.resolve(libRoot) +
        path.sep
      )
    ) {
      continue;
    }

    const content = String(
      file.content || ''
    ).trim();

    if (!content) continue;

    fs.mkdirSync(
      path.dirname(full),
      { recursive: true }
    );

    fs.writeFileSync(
      full,
      content + '\n',
      'utf8'
    );

    written++;
  }

  return written;
}

function collectFiles(projectName) {
  const projectRoot = root(projectName);
  const result = [];

  if (!fs.existsSync(projectRoot)) {
    return result;
  }

  function walk(dir) {
    for (
      const item of fs.readdirSync(
        dir,
        { withFileTypes: true }
      )
    ) {
      const full = path.join(
        dir,
        item.name
      );

      if (item.isDirectory()) {
        walk(full);
      } else if (
        item.isFile() &&
        item.name.endsWith('.dart')
      ) {
        result.push(
          path.relative(
            projectRoot,
            full
          )
        );
      }
    }
  }

  walk(
    path.join(
      projectRoot,
      'lib'
    )
  );

  return result.sort();
}

function collectAllProjectFiles(projectName) {
  const projectRoot = root(projectName);

  if (!fs.existsSync(projectRoot)) {
    return [];
  }

  const result = [];

  function walk(dir) {
    for (
      const item of fs.readdirSync(
        dir,
        { withFileTypes: true }
      )
    ) {
      const full = path.join(
        dir,
        item.name
      );

      if (item.isDirectory()) {
        walk(full);
      } else {
        result.push(
          path.relative(
            projectRoot,
            full
          )
        );
      }
    }
  }

  walk(projectRoot);

  return result.sort();
}

function detectImportedPackages(
  projectName
) {
  const projectRoot = root(projectName);
  const packages = new Set();

  for (
    const relative of collectFiles(projectName)
  ) {
    const full = path.join(
      projectRoot,
      relative
    );

    const source = fs.readFileSync(
      full,
      'utf8'
    );

    const regex =
      /import\s+['"]package:([^/]+)\//g;

    let match;

    while (
      (match = regex.exec(source))
    ) {
      const packageName = match[1];

      if (
        PACKAGE_VERSIONS[packageName]
      ) {
        packages.add(packageName);
      }
    }
  }

  return [...packages].sort();
}

function validateGeneratedFiles(
  projectName
) {
  const projectRoot = root(projectName);

  const errors = [];

  const files =
    collectFiles(projectName);

  if (!files.includes('lib/main.dart')) {
    errors.push(
      'lib/main.dart غير موجود'
    );
  }

  const pubspecPath = path.join(
    projectRoot,
    'pubspec.yaml'
  );

  if (!fs.existsSync(pubspecPath)) {
    errors.push(
      'pubspec.yaml غير موجود'
    );
  }

  const importedPackages =
    detectImportedPackages(projectName);

  for (
    const packageName of importedPackages
  ) {
    if (
      !PACKAGE_VERSIONS[packageName]
    ) {
      errors.push(
        `Package غير معروف: ${packageName}`
      );
    }
  }

  return {
    valid: errors.length === 0,
    errors,
    files,
    importedPackages
  };
}

async function buildProject(
  apiKey,
  projectName,
  plan
) {
  if (!apiKey) {
    throw new Error(
      'OPENROUTER_API_KEY غير موجود'
    );
  }

  const projectRoot =
    ensureProject(
      projectName,
      plan
    );

  console.log(
    '[ENGINE] pubspec.yaml created'
  );

  const stages = [
    'core',
    'data',
    'services',
    'ui'
  ];

  const results = [];

  let existingFiles = [];

  for (
    const stage of stages
  ) {
    console.log(
      `[ENGINE] بدء مرحلة ${stage}`
    );

    const result =
      await generateStage(
        apiKey,
        plan,
        stage,
        existingFiles
      );

    const files =
      Array.isArray(result?.files)
        ? result.files
        : [];

    if (!files.length) {
      throw new Error(
        `AI لم يولد ملفات في مرحلة ${stage}`
      );
    }

    const written =
      writeFiles(
        projectName,
        files
      );

    if (!written) {
      throw new Error(
        `لم يتم كتابة أي ملف في مرحلة ${stage}`
      );
    }

    existingFiles =
      collectFiles(projectName);

    results.push({
      stage,
      generated: files.length,
      written,
      files: existingFiles.length
    });

    console.log(
      `[ENGINE] اكتملت ${stage}: generated=${files.length}, written=${written}`
    );
  }

  const validation =
    validateGeneratedFiles(
      projectName
    );

  if (!validation.valid) {
    throw new Error(
      `PROJECT_VALIDATION_FAILED: ${validation.errors.join('; ')}`
    );
  }

  return {
    projectRoot,
    files: collectAllProjectFiles(
      projectName
    ),
    dartFiles: collectFiles(
      projectName
    ),
    importedPackages:
      validation.importedPackages,
    stages: results,
    validation
  };
}

module.exports = {
  MODEL,
  PACKAGE_VERSIONS,
  safeProjectName,
  root,
  createPubspec,
  ensureProject,
  buildProject,
  collectFiles,
  collectAllProjectFiles,
  detectImportedPackages,
  validateGeneratedFiles
};
