function normalizeLocalPackageImports(projectName, source) {
  const projectPackage = safeProjectName(projectName);

  return String(source || '').replace(
    /package:([a-zA-Z0-9_]+)\//g,
    (full, packageName) => {
      // Keep the current project's own package imports unchanged.
      if (packageName === projectPackage) {
        return full;
      }

      // Keep every known external Flutter/Dart package unchanged.
      if (PACKAGE_VERSIONS[packageName]) {
        return full;
      }

      // Flutter SDK packages must ALWAYS remain external imports.
      if (
        packageName === 'flutter' ||
        packageName === 'flutter_localizations' ||
        packageName === 'cupertino'
      ) {
        return full;
      }

      // Unknown package imports are left untouched.
      // The validator will report them if the dependency is missing.
      return full;
    }
  );
}

function writeFiles(projectName, files) {
  const projectRoot = root(projectName);
  const libRoot = path.join(
    projectRoot,
    'lib'
  );

  fs.mkdirSync(
    libRoot,
    { recursive: true }
  );

  let written = 0;

  for (
    const file of Array.isArray(files)
      ? files
      : []
  ) {
    if (
      !file ||
      typeof file !== 'object'
    ) {
      continue;
    }

    const relative = String(
      file.path || ''
    ).trim();

    if (
      !relative.startsWith('lib/') ||
      relative.includes('..') ||
      relative.includes('\\') ||
      !relative.endsWith('.dart')
    ) {
      continue;
    }

    const full = path.resolve(
      projectRoot,
      relative
    );

    if (
      !full.startsWith(
        path.resolve(libRoot) +
        path.sep
      )
    ) {
      continue;
    }

    const content = normalizeLocalPackageImports(
      projectName,
      String(file.content || '').trim()
    );

    if (!content) continue;

    fs.mkdirSync(
      path.dirname(full),
      { recursive: true }
    );

    fs.writeFileSync(
      full,
      content + '\n',
      'utf8'
    );

    written++;
  }

  return written;
}

function collectFiles(projectName) {
  const projectRoot = root(projectName);
  const result = [];

  if (!fs.existsSync(projectRoot)) {
    return result;
  }

  function walk(dir) {
    for (
      const item of fs.readdirSync(
        dir,
        { withFileTypes: true }
      )
    ) {
      const full = path.join(
        dir,
        item.name
      );

      if (item.isDirectory()) {
        walk(full);
      } else if (
        item.isFile() &&
        item.name.endsWith('.dart')
      ) {
        result.push(
          path.relative(
            projectRoot,
            full
          )
        );
      }
    }
  }

  walk(
    path.join(
      projectRoot,
      'lib'
    )
  );

  return result.sort();
}

function collectAllProjectFiles(projectName) {
  const projectRoot = root(projectName);

  if (!fs.existsSync(projectRoot)) {
    return [];
  }

  const result = [];

  function walk(dir) {
    for (
      const item of fs.readdirSync(
        dir,
        { withFileTypes: true }
      )
    ) {
      const full = path.join(
        dir,
        item.name
      );

      if (item.isDirectory()) {
        walk(full);
      } else {
        result.push(
          path.relative(
            projectRoot,
            full
          )
        );
      }
    }
  }

  walk(projectRoot);

  return result.sort();
}

function detectImportedPackages(
  projectName
) {
  const projectRoot = root(projectName);
  const packages = new Set();

  for (
    const relative of collectFiles(projectName)
  ) {
    const full = path.join(
      projectRoot,
      relative
    );

    const source = fs.readFileSync(
      full,
      'utf8'
    );

    const regex =
      /import\s+['"]package:([^/]+)\//g;

    let match;

    while (
      (match = regex.exec(source))
    ) {
      const packageName = match[1];

      if (
        PACKAGE_VERSIONS[packageName]
      ) {
        packages.add(packageName);
      }
    }
  }

  return [...packages].sort();
}

function validateGeneratedFiles(
  projectName
) {
  const projectRoot = root(projectName);

  const errors = [];

  const files =
    collectFiles(projectName);

  if (!files.includes('lib/main.dart')) {
    errors.push(
      'lib/main.dart غير موجود'
    );
  }

  const pubspecPath = path.join(
    projectRoot,
    'pubspec.yaml'
  );

  if (!fs.existsSync(pubspecPath)) {
    errors.push(
      'pubspec.yaml غير موجود'
    );
  }

  const importedPackages =
    detectImportedPackages(projectName);

  for (
    const packageName of importedPackages
  ) {
    if (
      !PACKAGE_VERSIONS[packageName]
    ) {
      errors.push(
        `Package غير معروف: ${packageName}`
      );
    }
  }

  return {
    valid: errors.length === 0,
    errors,
    files,
    importedPackages
  };
}


function createPubspec(projectName, plan) {
  const projectRoot = root(projectName);
  const pubspecPath = path.join(projectRoot, 'pubspec.yaml');

  fs.mkdirSync(projectRoot, { recursive: true });
  fs.mkdirSync(path.join(projectRoot, 'lib'), { recursive: true });

  const dependencies = Object.entries(PACKAGE_VERSIONS)
    .map(([name, version]) => '  ' + name + ': ' + version)
    .join('\n');

  const description = String(
    plan?.idea || plan?.description || 'Flutter application'
  )
    .replace(/\r?\n/g, ' ')
    .replace(/"/g, '\\"')
    .slice(0, 200);

  const content =
`name: ${safeProjectName(projectName)}
description: "${description}"
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: '>=3.9.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter
${dependencies}

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
`;

  fs.writeFileSync(pubspecPath, content, 'utf8');

  return pubspecPath;
}


function ensureFlutterPubspecDependencies(projectName, plan) {
  const projectRoot = root(projectName);

  const pubspecPath = path.join(
    projectRoot,
    'pubspec.yaml'
  );

  if (!fs.existsSync(pubspecPath)) {
    throw new Error(
      'PUBSPEC_NOT_FOUND: Flutter project did not create pubspec.yaml'
    );
  }

  let content = fs.readFileSync(
    pubspecPath,
    'utf8'
  );

  const dependencies = {
    flutter_localizations: null,
    ...PACKAGE_VERSIONS
  };

  const lines = content.split(/\r?\n/);

  let dependenciesIndex = lines.findIndex(
    line => line.trim() === 'dependencies:'
  );

  if (dependenciesIndex === -1) {
    throw new Error(
      'PUBSPEC_INVALID: dependencies section not found'
    );
  }

  let dependenciesEnd = lines.findIndex(
    (line, index) =>
      index > dependenciesIndex &&
      line.length > 0 &&
      !line.startsWith(' ') &&
      !line.startsWith('#')
  );

  if (dependenciesEnd === -1) {
    dependenciesEnd = lines.length;
  }

  const existing = new Set();

  for (
    let i = dependenciesIndex + 1;
    i < dependenciesEnd;
    i++
  ) {
    const match = lines[i].match(
      /^  ([a-zA-Z0-9_]+):/
    );

    if (match) {
      existing.add(match[1]);
    }
  }

  const additions = [];

  if (!existing.has('flutter_localizations')) {
    additions.push(
      '  flutter_localizations:',
      '    sdk: flutter'
    );
  }

  for (const [name, version] of Object.entries(
    PACKAGE_VERSIONS
  )) {
    if (existing.has(name)) {
      continue;
    }

    additions.push(
      '  ' + name + ': ' + version
    );
  }

  if (additions.length > 0) {
    lines.splice(
      dependenciesEnd,
      0,
      ...additions
    );
  }

  content = lines.join('\n');

  fs.writeFileSync(
    pubspecPath,
    content,
    'utf8'
  );

  console.log(
    '[ENGINE] Flutter pubspec dependencies configured'
  );

  return pubspecPath;
}


async function prepareFlutterBuild(projectName) {
  const projectRoot = root(projectName);

  if (!fs.existsSync(projectRoot)) {
    throw new Error(
      'FLUTTER_BUILD_PREP_FAILED: project root not found'
    );
  }

  console.log(
    '[ENGINE] تشغيل flutter pub get'
  );

  execFileSync(
    'flutter',
    ['pub', 'get'],
    {
      cwd: projectRoot,
      stdio: 'inherit',
      timeout: 300000
    }
  );

  console.log(
    '[ENGINE] تشغيل flutter analyze'
  );

  try {
    execFileSync(
      'flutter',
      ['analyze', 'lib'],
      {
        cwd: projectRoot,
        stdio: 'inherit',
        timeout: 300000
      }
    );
  } catch (error) {
    throw new Error(
      'FLUTTER_ANALYZE_FAILED: flutter analyze failed'
    );
  }

  console.log(
    '[ENGINE] Flutter project passed analyze'
  );

  return true;
}


function buildFlutterApk(projectName) {
  const projectRoot = root(projectName);

  if (!fs.existsSync(projectRoot)) {
    throw new Error(
      'APK_BUILD_FAILED: project root not found'
    );
  }

  console.log(
    '[ENGINE] بدء flutter build apk --release'
  );

  try {
    execFileSync(
      'flutter',
      [
        'build',
        'apk',
        '--release'
      ],
      {
        cwd: projectRoot,
        stdio: 'inherit',
        timeout: 600000
      }
    );
  } catch (error) {
    throw new Error(
      'FLUTTER_APK_BUILD_FAILED: flutter build apk --release failed'
    );
  }

  const apkCandidates = [
    path.join(
      projectRoot,
      'build',
      'app',
      'outputs',
      'flutter-apk',
      'app-release.apk'
    ),
    path.join(
      projectRoot,
      'build',
      'app',
      'outputs',
      'apk',
      'release',
      'app-release.apk'
    )
  ];

  const apkPath = apkCandidates.find(
    file => fs.existsSync(file)
  );

  if (!apkPath) {
    throw new Error(
      'APK_NOT_FOUND: Flutter build succeeded but APK was not found'
    );
  }

  console.log(
    '[ENGINE] تم إنشاء APK بنجاح: ' + apkPath
  );

  return apkPath;
}



async function repairFlutterProject(
  apiKey,
  projectName,
  plan,
  maxAttempts = 3
) {
  const projectRoot = root(projectName);

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    console.log(
      `[ENGINE] محاولة إصلاح Flutter ${attempt}/${maxAttempts}`
    );

    let analyzeOutput = '';

    try {
      analyzeOutput = execFileSync(
        'flutter',
        ['analyze', 'lib'],
        {
          cwd: projectRoot,
          encoding: 'utf8',
          stdio: ['ignore', 'pipe', 'pipe'],
          timeout: 300000
        }
      );
    } catch (error) {
      analyzeOutput =
        String(error.stdout || '') +
        '\n' +
        String(error.stderr || '');
    }

    analyzeOutput = analyzeOutput.trim();

    if (!analyzeOutput) {
      console.log(
        '[ENGINE] flutter analyze لم يرجع أخطاء'
      );
      return true;
    }

    if (
      /No issues found!/i.test(analyzeOutput) ||
      /0 issues found/i.test(analyzeOutput)
    ) {
      console.log(
        '[ENGINE] Flutter project صالح'
      );
      return true;
    }

    console.log(
      '[ENGINE] أخطاء Flutter المكتشفة:'
    );
    console.log(analyzeOutput.slice(0, 16000));

    const dartFiles = collectFiles(projectName);

    const relevantFiles = [];

    for (const relative of dartFiles) {
      const full = path.join(
        projectRoot,
        relative
      );

      if (!fs.existsSync(full)) {
        continue;
      }

      const content = fs.readFileSync(
        full,
        'utf8'
      );

      relevantFiles.push({
        path: relative,
        content
      });
    }

    const repairPrompt = `
You are repairing an existing real Flutter application.

Do NOT redesign the application.
Do NOT create a new application.
Do NOT remove existing functionality.
Do NOT use TODO.
Do NOT use placeholder code.
Do NOT use fake data.
Do NOT explain anything outside JSON.

The application MUST compile with current Flutter stable and Dart 3.9+.

PROJECT PLAN:
${JSON.stringify(plan)}

REAL FLUTTER ANALYZE OUTPUT:
${analyzeOutput.slice(0, 16000)}

CURRENT DART FILES:
${JSON.stringify(relevantFiles).slice(0, 50000)}

YOUR TASK:
1. Diagnose the actual compilation/analyzer errors.
2. Fix the existing Dart files.
3. Keep the existing architecture and UI design.
4. Make models, services, data sources and UI APIs consistent.
5. Never invent an API that does not exist.
6. Flutter SDK localization must use valid Flutter APIs.
7. TextDirection must use valid Dart/Flutter values.
8. Do not modify pubspec.yaml.
9. Do not generate test files.
10. Return ONLY files that must be changed.
11. Every returned file must contain its COMPLETE Dart source.
12. Every path must start with lib/ and end with .dart.
13. Maximum 8 files.

OUTPUT:
{
  "files": [
    {
      "path": "lib/example.dart",
      "purpose": "why this file must be fixed",
      "content": "complete Dart source"
    }
  ]
}
`;

    let result;

    try {
      result = await askAI(
        apiKey,
        [
          {
            role: 'system',
            content:
              'You are a senior Flutter debugging engineer. Return valid JSON only. Fix compilation errors in existing code.'
          },
          {
            role: 'user',
            content: repairPrompt
          }
        ],
        8000
      );
    } catch (error) {
      throw new Error(
        'FLUTTER_AUTO_REPAIR_AI_FAILED: ' +
        error.message
      );
    }

    const files =
      Array.isArray(result?.files)
        ? result.files
        : [];

    if (!files.length) {
      throw new Error(
        'FLUTTER_AUTO_REPAIR_EMPTY: AI returned no repair files'
      );
    }

    const written = writeFiles(
      projectName,
      files
    );

    if (!written) {
      throw new Error(
        'FLUTTER_AUTO_REPAIR_WRITE_FAILED: no files written'
      );
    }

    console.log(
      `[ENGINE] تم إصلاح ${written} ملف`
    );

    try {
      execFileSync(
        'flutter',
        ['pub', 'get'],
        {
          cwd: projectRoot,
          stdio: 'inherit',
          timeout: 300000
        }
      );
    } catch (error) {
      throw new Error(
        'FLUTTER_AUTO_REPAIR_PUB_GET_FAILED: ' +
        error.message
      );
    }
  }

  throw new Error(
    `FLUTTER_AUTO_REPAIR_FAILED: flutter analyze still fails after ${maxAttempts} attempts`
  );
}

function ensureProject(projectName, plan) {
  const projectRoot = root(projectName);

  fs.mkdirSync(projectRoot, { recursive: true });
  fs.mkdirSync(path.join(projectRoot, 'lib'), { recursive: true });

  const pubspecPath = path.join(projectRoot, 'pubspec.yaml');

  if (!fs.existsSync(pubspecPath)) {
    createPubspec(projectName, plan);
  }

  return projectRoot;
}

function validateDartConsistency(projectName) {
  const projectRoot = root(projectName);
  const libRoot = path.join(projectRoot, 'lib');
  const errors = [];

  if (!fs.existsSync(libRoot)) {
    return { valid: false, errors: ['lib directory غير موجود'] };
  }

  const dartFiles = [];

  function walk(dir) {
    for (const item of fs.readdirSync(dir, { withFileTypes: true })) {
      const full = path.join(dir, item.name);

      if (item.isDirectory()) {
        walk(full);
      } else if (item.isFile() && item.name.endsWith('.dart')) {
        dartFiles.push(full);
      }
    }
  }

  walk(libRoot);

  const relativeDartFiles = new Set(
    dartFiles.map(full =>
      path.relative(libRoot, full).split(path.sep).join('/')
    )
  );

  let packageName = safeProjectName(projectName);

  const pubspecPath = path.join(projectRoot, 'pubspec.yaml');

  if (fs.existsSync(pubspecPath)) {
    const pubspec = fs.readFileSync(pubspecPath, 'utf8');
    const match = pubspec.match(/^name:\s*([A-Za-z0-9_]+)\s*$/m);

    if (match) {
      packageName = match[1];
    }
  }

  const declarations = new Map();
  const allSource = new Map();

  for (const full of dartFiles) {
    const relative = path.relative(libRoot, full)
      .split(path.sep)
      .join('/');

    const source = fs.readFileSync(full, 'utf8');

    allSource.set(relative, source);

    const names = [
      ...source.matchAll(
        /\b(?:class|enum|mixin|extension)\s+([A-Za-z_]\w*)/g
      )
    ].map(m => m[1]);

    for (const name of names) {
      if (!declarations.has(name)) {
        declarations.set(name, []);
      }

      declarations.get(name).push(relative);
    }
  }

  for (const [relative, source] of allSource) {
    const imports = [
      ...source.matchAll(/import\s+['"]([^'"]+)['"]/g)
    ].map(m => m[1]);

    for (const importPath of imports) {

      if (importPath.startsWith('package:')) {
        const match = importPath.match(/^package:([^/]+)\/(.+)$/);

        if (!match) {
          errors.push(
            relative + ': package import غير صالح: ' + importPath
          );
          continue;
        }

        const importedPackage = match[1];
        const importedFile = match[2];

        if (importedPackage === packageName) {
          if (!relativeDartFiles.has(importedFile)) {
            errors.push(
              relative +
              ': import داخلي غير موجود: ' +
              importPath
            );
          }
        } else if (!PACKAGE_VERSIONS[importedPackage]) {
          errors.push(
            relative +
            ': package غير موجود في PACKAGE_VERSIONS: ' +
            importedPackage
          );
        }
      }

      if (
        importPath.startsWith('../') ||
        importPath.startsWith('./')
      ) {
        const currentDir = path.posix.dirname(relative);

        const normalized = path.posix.normalize(
          path.posix.join(currentDir, importPath)
        );

        if (!relativeDartFiles.has(normalized)) {
          errors.push(
            relative +
            ': relative import غير موجود: ' +
            importPath
          );
        }
      }
    }
  }

  const taskSource =
    [...allSource.entries()]
      .find(([relative]) =>
        /(^|\/)task\.dart$/.test(relative)
      )?.[1] || '';

  if (taskSource) {
    const hasText =
      /\bfinal\s+String\s+text\s*;/.test(taskSource);

    const hasTitle =
      /\bfinal\s+String\s+title\s*;/.test(taskSource);

    const hasCompleted =
      /\bbool\s+completed\b/.test(taskSource);

    const hasIsDone =
      /\bbool\s+isDone\b/.test(taskSource);

    if (!hasText && !hasTitle) {
      errors.push(
        'Task model لا يحتوي text أو title'
      );
    }

    if (!hasCompleted && !hasIsDone) {
      errors.push(
        'Task model لا يحتوي completed أو isDone'
      );
    }
  }

  const taskServiceSource =
    [...allSource.entries()]
      .find(([relative]) =>
        /(^|\/)task_service\.dart$/.test(relative)
      )?.[1] || '';

  const dataSource =
    [...allSource.entries()]
      .find(([relative]) =>
        /(^|\/)task_local_data_source\.dart$/.test(relative)
      )?.[1] || '';

  if (taskServiceSource && dataSource) {

    const serviceCalls = [
      ...taskServiceSource.matchAll(
        /\b_localDataSource\.(\w+)\s*\(/g
      )
    ].map(m => m[1]);

    const dataMethods = new Set(
      [
        ...dataSource.matchAll(
          /\b(?:Future<[^>]+>|void|[A-Za-z_][\w<>?]*)\s+(\w+)\s*\(/g
        )
      ].map(m => m[1])
    );

    for (const method of serviceCalls) {
      if (!dataMethods.has(method)) {
        errors.push(
          'TaskService يستدعي دالة غير موجودة في TaskLocalDataSource: ' +
          method
        );
      }
    }
  }

  if (taskServiceSource) {

    const serviceConstructor =
      taskServiceSource.match(
        /class\s+TaskService[^{]*\{[\s\S]*?TaskService\s*\(([^)]*)\)/
      );

    const homeSource =
      [...allSource.entries()]
        .find(([relative]) =>
          /(^|\/)home_page\.dart$/.test(relative)
        )?.[1] || '';

    if (
      serviceConstructor &&
      homeSource &&
      serviceConstructor[1].trim().length > 0 &&
      /\bTaskService\s*\(\s*\)/.test(homeSource)
    ) {
      errors.push(
        'HomePage ينشئ TaskService() بينما TaskService يحتاج constructor arguments'
      );
    }
  }

  if (taskSource) {

    const hasText =
      /\bfinal\s+String\s+text\s*;/.test(taskSource);

    const hasTitle =
      /\bfinal\s+String\s+title\s*;/.test(taskSource);

    const hasCompleted =
      /\bbool\s+completed\b/.test(taskSource);

    const hasIsDone =
      /\bbool\s+isDone\b/.test(taskSource);

    const taskFiles = [...allSource.entries()]
      .filter(([relative]) =>
        /(^|\/)(home_page|task_dialog|task_service)\.dart$/.test(relative)
      );

    for (const [relative, source] of taskFiles) {

      if (hasText && /\btask\.title\b|\btask\.description\b/.test(source)) {
        errors.push(
          relative +
          ': يستخدم Task.title أو Task.description بينما النموذج يستخدم text'
        );
      }

      if (hasTitle && /\btask\.text\b/.test(source)) {
        errors.push(
          relative +
          ': يستخدم Task.text بينما النموذج يستخدم title'
        );
      }

      if (hasCompleted && /\btask\.(?:isDone|isCompleted)\b/.test(source)) {
        errors.push(
          relative +
          ': يستخدم isDone/isCompleted بينما النموذج يستخدم completed'
        );
      }

      if (hasIsDone && /\btask\.completed\b/.test(source)) {
        errors.push(
          relative +
          ': يستخدم completed بينما النموذج يستخدم isDone'
        );
      }
    }
  }

  const uniqueErrors = [...new Set(errors)];

  return {
    valid: uniqueErrors.length === 0,
    errors: uniqueErrors,
    dartFiles: relativeDartFiles.size,
    packageName
  };
}


function writeGitHubWorkflow(projectName) {
  const projectRoot = root(projectName);
  const workflowDir = path.join(projectRoot, '.github', 'workflows');
  const workflowPath = path.join(workflowDir, 'build-apk.yml');

  fs.mkdirSync(workflowDir, { recursive: true });

  const workflow = `name: Mahani Builder - Android APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Verify Flutter
        run: |
          flutter --version
          dart --version

      - name: Configure Android
        shell: bash
        run: |
          set -e

          FILE="android/app/build.gradle.kts"

          python3 - <<'PY2'
          from pathlib import Path
          import re

          p = Path("android/app/build.gradle.kts")
          s = p.read_text()

          if "isCoreLibraryDesugaringEnabled" not in s:
              if "compileOptions {" not in s:
                  raise SystemExit("compileOptions block not found")

              s = s.replace(
                  "compileOptions {",
                  """compileOptions {
        isCoreLibraryDesugaringEnabled = true""",
                  1
              )

          elif "isCoreLibraryDesugaringEnabled = false" in s:
              s = s.replace(
                  "isCoreLibraryDesugaringEnabled = false",
                  "isCoreLibraryDesugaringEnabled = true"
              )

          s = re.sub(
              r"sourceCompatibility\\\\s*=\\\\s*JavaVersion\\\\.VERSION_\\\\d+",
              "sourceCompatibility = JavaVersion.VERSION_17",
              s
          )

          s = re.sub(
              r"targetCompatibility\\\\s*=\\\\s*JavaVersion\\\\.VERSION_\\\\d+",
              "targetCompatibility = JavaVersion.VERSION_17",
              s
          )

          if "sourceCompatibility" not in s:
              s = s.replace(
                  "isCoreLibraryDesugaringEnabled = true",
                  """isCoreLibraryDesugaringEnabled = true
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17""",
                  1
              )

          dependency = 'coreLibraryDesugaring("com.android.tools:desugar_jdk_libs:2.1.5")'

          if "coreLibraryDesugaring(" not in s:
              if "dependencies {" in s:
                  s = s.replace(
                      "dependencies {",
                      f"""dependencies {{
    {dependency}""",
                      1
                  )
              else:
                  s += f"""

dependencies {{
    {dependency}
}}
"""

          p.write_text(s)
          PY2

          grep -q "isCoreLibraryDesugaringEnabled = true" "$FILE"
          grep -q "coreLibraryDesugaring(" "$FILE"

      - name: Get dependencies
        run: flutter pub get

      - name: Analyze project
        run: flutter analyze

      - name: Build release APK
        run: flutter build apk --release

      - name: Verify APK
        run: |
          set -e
          APK="build/app/outputs/flutter-apk/app-release.apk"
          test -f "$APK"
          echo "APK CREATED SUCCESSFULLY"
          ls -lh "$APK"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: mahani_app-apk
          path: build/app/outputs/flutter-apk/app-release.apk
          if-no-files-found: error
          retention-days: 7
`;

  fs.writeFileSync(workflowPath, workflow, 'utf8');

  console.log('[ENGINE] GitHub Actions workflow created: ' + workflowPath);

  return workflowPath;
}

async function buildProject(
  apiKey,
  projectName,
  plan
) {
  if (!apiKey) {
    throw new Error(
      'OPENROUTER_API_KEY غير موجود'
    );
  }

  const projectRoot =
    createFlutterAndroidProject(
      projectName,
      plan
    );

  ensureFlutterPubspecDependencies(
    projectName,
    plan
  );

  console.log(
    '[ENGINE] Flutter Android project + dependencies configured'
  );

  const stages = [
    'core',
    'data',
    'services',
    'ui'
  ];

  const results = [];

  let existingFiles = [];

  for (
    const stage of stages
  ) {
    console.log(
      `[ENGINE] بدء مرحلة ${stage}`
    );

    const result =
      await generateStage(
        apiKey,
        plan,
        stage,
        existingFiles
      );

    const files =
      Array.isArray(result?.files)
        ? result.files
        : [];

    if (!files.length) {
      throw new Error(
        `AI لم يولد ملفات في مرحلة ${stage}`
      );
    }

    const written =
      writeFiles(
        projectName,
        files
      );

    if (!written) {
      throw new Error(
        `لم يتم كتابة أي ملف في مرحلة ${stage}`
      );
    }

    existingFiles =
      collectFiles(projectName);

    results.push({
      stage,
      generated: files.length,
      written,
      files: existingFiles.length
    });

    console.log(
      `[ENGINE] اكتملت ${stage}: generated=${files.length}, written=${written}`
    );
  }

  console.log(
    '[ENGINE] بدء التحقق الحقيقي بواسطة Flutter'
  );

  try {
    await prepareFlutterBuild(
      projectName
    );
  } catch (error) {
    console.log(
      '[ENGINE] flutter analyze فشل — بدء الإصلاح التلقائي بواسطة AI'
    );

    await repairFlutterProject(
      apiKey,
      projectName,
      plan,
      3
    );

    console.log(
      '[ENGINE] إعادة التحقق بعد الإصلاح التلقائي'
    );

    await prepareFlutterBuild(
      projectName
    );
  }

  const validation =
    validateGeneratedFiles(
      projectName
    );

  if (!validation.valid) {
    throw new Error(
      `PROJECT_VALIDATION_FAILED: ${validation.errors.join('; ')}`
    );
  }

  writeGitHubWorkflow(projectName);

  const githubActions = require('./github-actions');

  const githubOwner = String(
    process.env.GITHUB_OWNER || ''
  ).trim();

  const githubToken = String(
    process.env.GITHUB_TOKEN || ''
  ).trim();

  if (!githubOwner) {
    throw new Error(
      'GITHUB_BUILD_FAILED: GITHUB_OWNER غير موجود في .env'
    );
  }

  if (!githubToken) {
    throw new Error(
      'GITHUB_BUILD_FAILED: GITHUB_TOKEN غير موجود في .env'
    );
  }

  const githubOutputDir = path.join(
    projectRoot,
    'github-build'
  );

  fs.mkdirSync(githubOutputDir, {
    recursive: true
  });

  console.log(
    '[ENGINE] بدء البناء الحقيقي عبر GitHub Actions'
  );

  const githubBuild =
    await githubActions.buildProject(
      githubOwner,
      projectName,
      githubToken,
      projectRoot,
      githubOutputDir
    );

  const apkPath = githubBuild.apkPath;

  console.log(
    '[ENGINE] تم إنشاء APK عبر GitHub Actions: ' +
    apkPath
  );

  return {
    projectRoot,
    apkPath,
    files: collectAllProjectFiles(
      projectName
    ),
    dartFiles: collectFiles(
      projectName
    ),
    importedPackages:
      validation.importedPackages,
    stages: results,
    validation
  };
}

