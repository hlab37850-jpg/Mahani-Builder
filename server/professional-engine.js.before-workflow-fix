const MODEL = process.env.OPENROUTER_MODEL || 'nvidia/nemotron-3-ultra-550b-a55b:free';

function safeProjectName(name) {
  return String(name || 'mahani_app')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_]+/g, '_')
    .replace(/^_+|_+$/g, '')
    .replace(/_+/g, '_')
    .slice(0, 50) || `mahani_app_${Date.now()}`;
}

function root(projectName) {
  return path.join(
    __dirname,
    'projects',
    safeProjectName(projectName)
  );
}


function createFlutterAndroidProject(projectName, plan) {
  const projectRoot = root(projectName);
  const projectNameSafe = safeProjectName(projectName);

  fs.mkdirSync(
    path.dirname(projectRoot),
    { recursive: true }
  );

  console.log(
    '[ENGINE] إنشاء Flutter Android project حقيقي'
  );

  if (
    fs.existsSync(projectRoot) &&
    fs.existsSync(path.join(projectRoot, 'android'))
  ) {
    console.log(
      '[ENGINE] Android project موجود بالفعل'
    );
    return projectRoot;
  }

  if (fs.existsSync(projectRoot)) {
    fs.rmSync(
      projectRoot,
      {
        recursive: true,
        force: true
      }
    );
  }

  execFileSync(
    'flutter',
    [
      'create',
      '--platforms=android',
      '--project-name',
      projectNameSafe,
      projectRoot
    ],
    {
      stdio: 'inherit',
      timeout: 180000
    }
  );

  if (
    !fs.existsSync(
      path.join(projectRoot, 'android')
    )
  ) {
    throw new Error(
      'FLUTTER_CREATE_FAILED: مجلد android لم يتم إنشاؤه'
    );
  }

  if (
    !fs.existsSync(
      path.join(projectRoot, 'pubspec.yaml')
    )
  ) {
    throw new Error(
      'FLUTTER_CREATE_FAILED: pubspec.yaml لم يتم إنشاؤه'
    );
  }

  console.log(
    '[ENGINE] تم إنشاء Flutter Android project بنجاح'
  );

  return projectRoot;
}

async function askAI(apiKey, messages, maxTokens = 12000) {
  const { execFile } = require('child_process');

  const models = [
    MODEL,
    'cohere/north-mini-code:free',
    'nvidia/nemotron-3-super-120b-a12b:free',
    'openai/gpt-oss-20b:free',
    'google/gemma-4-31b-it:free'
  ].filter((value, index, array) =>
    value && array.indexOf(value) === index
  );

  function callCurl(model, tokenLimit) {
    const payload = JSON.stringify({
      model,
      messages,
      temperature: 0,
      max_tokens: tokenLimit,
      response_format: {
        type: 'json_object'
      }
    });

    return new Promise((resolve, reject) => {
      execFile(
        'curl',
        [
          '--silent',
          '--show-error',
          '--fail-with-body',
          '--connect-timeout', '30',
          '--max-time', '180',
          'https://openrouter.ai/api/v1/chat/completions',
          '-H', 'Authorization: Bearer ' + apiKey,
          '-H', 'Content-Type: application/json',
          '-H', 'HTTP-Referer: http://127.0.0.1:3000',
          '-H', 'X-Title: Mahani Builder AI',
          '--data', payload
        ],
        {
          maxBuffer: 30 * 1024 * 1024
        },
        (error, stdout, stderr) => {
          const raw = String(stdout || '').trim();
          const err = String(stderr || '').trim();

          let data = null;

          if (raw) {
            try {
              data = JSON.parse(raw);
            } catch {
              return reject(new Error(
                'OpenRouter returned invalid JSON: ' +
                raw.slice(0, 8000)
              ));
            }
          }

          if (error) {
            const providerError =
              data && data.error
                ? JSON.stringify(data.error)
                : raw.slice(0, 8000);

            return reject(new Error(
              'OpenRouter curl failed: ' +
              (err || error.message) +
              '; RESPONSE=' +
              providerError
            ));
          }

          if (!data) {
            return reject(new Error(
              'OpenRouter returned an empty response'
            ));
          }

          if (data.error) {
            return reject(new Error(
              'OpenRouter API error: ' +
              JSON.stringify(data.error).slice(0, 8000)
            ));
          }

          const choice =
            data &&
            data.choices &&
            data.choices[0];

          const finish =
            choice &&
            choice.finish_reason || 'unknown';

          const content =
            choice &&
            choice.message &&
            choice.message.content;

          console.log(
            '[AI] model=' +
            (data.model || model) +
            ' provider=' +
            (data.provider || 'unknown') +
            ' tokens=' +
            tokenLimit +
            ' finish=' +
            finish +
            ' content=' +
            (typeof content === 'string'
              ? content.length
              : 0)
          );

          if (!content) {
            return reject(new Error(
              'AI returned no content: finish_reason=' +
              finish +
              '; usage=' +
              JSON.stringify(data.usage || {}) +
              '; choice=' +
              JSON.stringify(choice || {}).slice(0, 8000)
            ));
          }

          let clean =
            typeof content === 'string'
              ? content
              : JSON.stringify(content);

          clean = clean
            .replace(/^```json\s*/i, '')
            .replace(/^```\s*/i, '')
            .replace(/\s*```$/, '')
            .trim();

          try {
            resolve(JSON.parse(clean));
          } catch {
            reject(new Error(
              'AI returned invalid JSON content: ' +
              clean.slice(0, 8000)
            ));
          }
        }
      );
    });
  }

  const firstLimit = Math.min(
    Math.max(4000, Number(maxTokens) || 8000),
    8000
  );

  let lastError = null;

  for (const model of models) {
    console.log('');
    console.log(
      '[AI] محاولة النموذج: ' + model
    );

    try {
      console.log(
        '[AI] tokens=' + firstLimit
      );

      return await callCurl(
        model,
        firstLimit
      );
    } catch (firstError) {
      lastError = firstError;

      console.log(
        '[AI] فشل النموذج ' +
        model +
        ' بالمحاولة الأولى:'
      );

      console.log(firstError.message);

      console.log(
        '[AI] إعادة المحاولة بـ 4000 tokens...'
      );

      try {
        return await callCurl(
          model,
          4000
        );
      } catch (secondError) {
        lastError = secondError;

        console.log(
          '[AI] فشل النموذج ' +
          model +
          ' بالمحاولة الثانية:'
        );

        console.log(secondError.message);

        console.log(
          '[AI] الانتقال إلى النموذج الاحتياطي التالي...'
        );
      }
    }
  }

  throw new Error(
    'AI generation failed: all fallback models failed. LAST=' +
    (lastError
      ? lastError.message
      : 'unknown error')
  );
}

