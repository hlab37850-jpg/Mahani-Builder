const fs = require('fs');
const path = require('path');

const MODEL = process.env.OPENROUTER_MODEL || 'cohere/north-mini-code:free';

function safeProjectName(name) {
  return String(name || 'mahani_app')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9_]+/g, '_')
    .replace(/^_+|_+$/g, '')
    .replace(/_+/g, '_')
    .slice(0, 50) || `mahani_app_${Date.now()}`;
}

function root(projectName) {
  return path.join(__dirname, 'projects', safeProjectName(projectName));
}

async function askAI(apiKey, messages, maxTokens = 12000) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 90000);

  try {
    const response = await fetch(
      'https://openrouter.ai/api/v1/chat/completions',
      {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
          'HTTP-Referer': 'http://127.0.0.1:3000',
          'X-Title': 'Mahani Builder AI'
        },
        body: JSON.stringify({
          model: MODEL,
          messages,
          temperature: 0,
          max_tokens: maxTokens,
          reasoning: {
            effort: 'minimal',
            exclude: true
          },
          response_format: {
            type: 'json_object'
          }
        }),
        signal: controller.signal
      }
    );

    const text = await response.text();

    let data;
    try {
      data = JSON.parse(text);
    } catch {
      throw new Error('OpenRouter returned invalid JSON');
    }

    if (!response.ok) {
      throw new Error(
        `OpenRouter HTTP ${response.status}: ${JSON.stringify(data).slice(0, 1500)}`
      );
    }

    const choice = data?.choices?.[0];

    if (!choice?.message?.content) {
      throw new Error(
        `AI generation failed: finish_reason=${choice?.finish_reason || 'unknown'}`
      );
    }

    let content = choice.message.content;

    if (typeof content !== 'string') {
      content = JSON.stringify(content);
    }

    content = content
      .replace(/^```json\s*/i, '')
      .replace(/^```\s*/i, '')
      .replace(/\s*```$/i, '')
      .trim();

    try {
      return JSON.parse(content);
    } catch {
      throw new Error('AI returned invalid JSON content');
    }
  } finally {
    clearTimeout(timer);
  }
}

