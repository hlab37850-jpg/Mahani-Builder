async function generateStage(apiKey, plan, stage, existingFiles) {
  return askAI(
    apiKey,
    [
      {
        role: 'system',
        content:
          'You are a senior Flutter production engineer. Return valid JSON only.'
      },
      {
        role: 'user',
        content: buildGenerationPrompt(plan, stage, existingFiles)
      }
    ],
    14000
  );
}

function writeFiles(projectName, files) {
  const projectRoot = root(projectName);
  const libRoot = path.join(projectRoot, 'lib');

  fs.mkdirSync(libRoot, { recursive: true });

  let written = 0;

  for (const file of Array.isArray(files) ? files : []) {
    if (!file || typeof file !== 'object') continue;

    const relative = String(file.path || '').trim();

    if (
      !relative.startsWith('lib/') ||
      relative.includes('..') ||
      relative.includes('\\') ||
      !relative.endsWith('.dart')
    ) {
      continue;
    }

    const full = path.resolve(projectRoot, relative);

    if (!full.startsWith(path.resolve(libRoot) + path.sep)) {
      continue;
    }

    const content = String(file.content || '').trim();

    if (!content) continue;

    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content + '\n', 'utf8');
    written++;
  }

  return written;
}

function collectFiles(projectName) {
  const projectRoot = root(projectName);
  const libRoot = path.join(projectRoot, 'lib');

  if (!fs.existsSync(libRoot)) return [];

  const result = [];

  function walk(dir) {
    for (const item of fs.readdirSync(dir, { withFileTypes: true })) {
      const full = path.join(dir, item.name);

      if (item.isDirectory()) {
        walk(full);
      } else if (item.isFile() && item.name.endsWith('.dart')) {
        result.push(path.relative(projectRoot, full));
      }
    }
  }

  walk(libRoot);
  return result.sort();
}

async function buildProject(apiKey, projectName, plan) {
  if (!apiKey) throw new Error('OPENROUTER_API_KEY غير موجود');

  const stages = ['core', 'data', 'services', 'ui'];
  const results = [];
  let existingFiles = [];

  for (const stage of stages) {
    console.log(`[ENGINE] بدء مرحلة ${stage}`);

    const result = await generateStage(
      apiKey,
      plan,
      stage,
      existingFiles
    );

    const files = Array.isArray(result?.files) ? result.files : [];

    if (!files.length) {
      throw new Error(`AI لم يولد ملفات في مرحلة ${stage}`);
    }

    const written = writeFiles(projectName, files);

    existingFiles = collectFiles(projectName);

    results.push({
      stage,
      generated: files.length,
      written,
      files: existingFiles.length
    });

    console.log(
      `[ENGINE] اكتملت ${stage}: generated=${files.length}, written=${written}`
    );
  }

  return {
    projectRoot: root(projectName),
    files: collectFiles(projectName),
    stages: results
  };
}

module.exports = {
  MODEL,
  safeProjectName,
  buildProject,
  collectFiles
};
