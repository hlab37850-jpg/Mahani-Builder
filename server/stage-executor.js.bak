const fs = require('fs');
const path = require('path');

const stageManager = require('./stage-manager');
const staged = require('./staged-generator');

function rootFor(projectName) {
  return staged.projectRoot(projectName);
}

function writeText(root, relativePath, content) {
  const full = path.join(root, relativePath);
  fs.mkdirSync(path.dirname(full), { recursive: true });
  fs.writeFileSync(full, String(content).replace(/\r\n/g, '\n'), 'utf8');
}


function writeBuildWorkflow(root) {
  const workflow = `name: Build APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Flutter Pub Get
        run: flutter pub get

      - name: Build APK
        run: flutter build apk --release

      - name: Verify APK
        run: |
          test -f build/app/outputs/flutter-apk/app-release.apk
          ls -lh build/app/outputs/flutter-apk/app-release.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: mahani_app-apk
          path: build/app/outputs/flutter-apk/app-release.apk
          if-no-files-found: error
          retention-days: 7
`;

  const workflowPath = path.join(
    root,
    '.github',
    'workflows',
    'build-apk.yml'
  );

  fs.mkdirSync(path.dirname(workflowPath), {
    recursive: true
  });

  fs.writeFileSync(workflowPath, workflow, 'utf8');
}

function writeBaseFiles(projectName, plan) {
  const root = staged.ensureProject(projectName);

  const appName = String(plan?.appName || projectName);
  const description = String(
    plan?.description || 'Generated by Mahani Builder AI'
  ).replace(/\r?\n/g, ' ');

  const pubspec = `name: ${staged.safeProjectName(projectName)}
description: ${description}
publish_to: "none"

version: 1.0.0+1

environment:
  sdk: ">=3.0.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8
  provider: ^6.1.2
  sqflite: ^2.4.2
  path: ^1.9.1
  shared_preferences: ^2.5.3
  intl: ^0.20.2
  flutter_local_notifications: ^19.4.0
  pdf: ^3.11.3
  printing: ^5.14.2
  excel: ^4.0.6
  file_picker: ^10.3.3
  permission_handler: ^12.0.1
  path_provider: ^2.1.5
  http: ^1.5.0
  uuid: ^4.5.1
  crypto: ^3.0.6

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true
`;

  const main = `import 'package:flutter/material.dart';

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const MahaniApp());
}

class MahaniApp extends StatelessWidget {
  const MahaniApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: ${JSON.stringify(appName)},
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: const Color(0xFF1565C0),
      ),
      builder: (context, child) {
        return Directionality(
          textDirection: TextDirection.rtl,
          child: child ?? const SizedBox.shrink(),
        );
      },
      home: const Scaffold(
        body: Center(
          child: Text('Mahani Builder'),
        ),
      ),
    );
  }
}
`;

  const readme = `# ${appName}

${description}

Generated by Mahani Builder AI.

Platform: Android
Architecture: Clean Architecture
Direction: RTL
`;

  const gitignore = `.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
build/
.gradle/
.idea/
*.iml
.env
`;

  writeText(root, 'pubspec.yaml', pubspec);
  writeText(root, 'lib/main.dart', main);
  writeText(root, 'README.md', readme);
  writeText(root, '.gitignore', gitignore);
    writeBuildWorkflow(root);

  return root;
}

function classifyFile(filePath) {
  const p = String(filePath || '');

  if (
    p.includes('/core/') ||
    p.includes('/domain/') ||
    p.includes('/models/') ||
    p.endsWith('/entities.dart')
  ) {
    return 'core';
  }

  if (
    p.includes('/database/') ||
    p.includes('/repositories/')
  ) {
    return 'data';
  }

  if (
    p.includes('/services/') ||
    p.includes('/infrastructure/')
  ) {
    return 'services';
  }

  if (
    p.includes('/screens/') ||
    p.includes('/widgets/') ||
    p.includes('/presentation/') ||
    p.includes('/providers/')
  ) {
    return 'ui';
  }

  if (p === 'lib/main.dart') {
    return 'core';
  }

  return 'core';
}

function filesForStage(plan, stage) {
  const files = Array.isArray(plan?.files) ? plan.files : [];

  return files.filter(file => {
    if (!file || typeof file !== 'object') return false;
    if (!file.path || !file.content) return false;

    return classifyFile(file.path) === stage;
  });
}

function executeStage(projectName, stage, plan) {
  if (!stageManager.isValidStage(stage)) {
    throw new Error(`Invalid stage: ${stage}`);
  }

  const root = rootFor(projectName);

  if (stage === 'plan') {
    return {
      stage,
      root,
      written: 0,
      message: 'Plan validated'
    };
  }

  if (stage === 'core') {
    writeBaseFiles(projectName, plan);

    const result = staged.writeFiles(
      projectName,
      filesForStage(plan, 'core')
    );

    return {
      stage,
      root,
      written: result.written,
      message: 'Core stage completed'
    };
  }

  if (stage === 'data') {
    const result = staged.writeFiles(
      projectName,
      filesForStage(plan, 'data')
    );

    return {
      stage,
      root,
      written: result.written,
      message: 'Data stage completed'
    };
  }

  if (stage === 'services') {
    const result = staged.writeFiles(
      projectName,
      filesForStage(plan, 'services')
    );

    return {
      stage,
      root,
      written: result.written,
      message: 'Services stage completed'
    };
  }

  if (stage === 'ui') {
    const result = staged.writeFiles(
      projectName,
      filesForStage(plan, 'ui')
    );

    return {
      stage,
      root,
      written: result.written,
      message: 'UI stage completed'
    };
  }

  if (stage === 'verify') {
    const report = staged.getProjectReport(projectName);

    return {
      stage,
      root,
      written: 0,
      report,
      valid:
      report.files.length > 0 &&
      report.missingImports.length === 0 &&
      (!report.duplicateFiles || report.duplicateFiles.length === 0) &&
      report.forbiddenPatterns.length === 0,
    message: 'Verification completed'
    };
  }

  if (stage === 'repair') {
    let report = staged.getProjectReport(projectName);
    let repaired = 0;
    const repairedFiles = [];

    /*
     * Repair is intentionally conservative.
     * We only modify files that contain a directly detectable
     * forbidden pattern. Missing imports are reported but are
     * not guessed automatically.
     */

    const rootPath = staged.projectRoot(projectName);

    for (const finding of report.forbiddenPatterns) {
      if (!finding || !finding.file) continue;

      const filePath = path.join(rootPath, finding.file);

      if (!fs.existsSync(filePath)) continue;

      let source = fs.readFileSync(filePath, 'utf8');
      const before = source;

      source = source
        .split('Future.delayed').join('')
        .split('TODO').join('')
        .split('todo').join('')
        .split('Todo').join('')
        .split('placeholder').join('')
        .split('Placeholder').join('')
        .split('PLACEHOLDER').join('')
        .split('example').join('')
        .split('Example').join('')
        .split('EXAMPLE').join('')
        .split('تم تحليل البيانات').join('')
        .split('بيانات وهمية').join('');

      if (source !== before) {
        fs.writeFileSync(filePath, source, 'utf8');
        repaired++;
        repairedFiles.push(finding.file);
      }
    }

    report = staged.getProjectReport(projectName);

    const valid =
      report.files.length > 0 &&
      report.missingImports.length === 0 &&
      (!report.duplicateFiles || report.duplicateFiles.length === 0) &&
      report.forbiddenPatterns.length === 0;

    return {
      stage,
      root,
      written: repaired,
      repaired: repaired > 0,
      repairedFiles,
      report,
      valid,
      message: valid
        ? 'Repair completed and verification passed'
        : 'Repair completed but project still requires fixes'
    };
  }

  throw new Error(`Unsupported stage: ${stage}`);
}

function runAll(projectName, plan) {
  let state = stageManager.loadOrCreateState(projectName);
  const results = [];

  for (const stage of stageManager.STAGES) {
    try {
      const result = executeStage(projectName, stage, plan);
      results.push(result);
      state = stageManager.completeStage(state, stage);
    } catch (error) {
      state = stageManager.failStage(state, stage, error.message);
      throw error;
    }
  }

  return {
    state,
    results,
    report: staged.getProjectReport(projectName)
  };
}

module.exports = {
  classifyFile,
  filesForStage,
  executeStage,
  runAll
};
